# Grace Treasury — environment configuration
# Copy this file to .env and adjust the values before running docker compose.

# REQUIRED: a long random secret used to sign login tokens.
# Generate one with:  openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# Database name
DB_NAME=church_treasury

# Allowed frontend origin(s), comma-separated. Match the URL you open in the browser.
CORS_ORIGINS=http://localhost:8080

# Address (or CIDR range) that cloudflared connects to Grace Treasury from. Only this
# source is trusted to report the visitor's real IP (used for login rate limits).
# The default fits cloudflared running in the same VM/host as the app.
TRUSTED_PROXY=172.16.0.0/12
